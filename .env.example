# ═══════════════════════════════════════════════════════════════
#  Yasa Drive — contoh environment. Salin ke `.env` lalu isi.
#    cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Storage Console (sesi sealed-cookie nuxt-auth-utils) ──
# Kunci enkripsi cookie sesi console. WAJIB acak & panjang (≥32 char).
#   generate:  openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# ── MinIO ──
# Endpoint S3 API MinIO (bukan port console :9001).
NUXT_MINIO_ENDPOINT=http://127.0.0.1:9000
# Opsional: path binary `mc` kalau tidak ada di ./bin/mc(.exe) atau PATH.
# NUXT_MC_PATH=

# ── Service account MinIO untuk backend Drive ──
# Idealnya user MinIO khusus dengan policy scoped (JANGAN pakai root di produksi).
NUXT_DRIVE_MINIO_ACCESS_KEY=
NUXT_DRIVE_MINIO_SECRET_KEY=

# ── Database (PostgreSQL) ──
DATABASE_URL=postgres://user:password@127.0.0.1:5432/drive

# ── better-auth (sesi Drive: email + password) ──
# Secret ≥32 char.  generate:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL PUBLIK aplikasi. Saat produksi WAJIB diganti ke domain asli,
# mis. https://drive.example.com (dipakai untuk cookie & base URL link).
BETTER_AUTH_URL=http://localhost:3001

# ── App ──
# Email di sini otomatis dapat role admin saat daftar (comma-separated).
ADMIN_EMAILS=admin@example.com

# ── Demo mode (opsional, khusus dev/desain) ──
# Kalau di-set "1": SEMUA endpoint /api dijawab data palsu (tanpa MinIO/DB).
# Kosongkan / hapus untuk konek beneran.
# NUXT_DEMO=
